# ======================================================================
#   HANDFISH — Konfigurasi Environment (.env)
#   Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# ======================================================================

# ----------------------------------------------------------------------
# Server Web
# ----------------------------------------------------------------------
SA_HOST=0.0.0.0
SA_PORT=8000

# Aktifkan Swagger UI di /api/docs (default false demi keamanan)
SA_ENABLE_DOCS=false

# Tingkat logging: DEBUG, INFO, WARNING, ERROR
SA_LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# Keamanan & Autentikasi
# ----------------------------------------------------------------------

# Kunci penandatanganan JWT (HS256). WAJIB diisi di produksi.
# Jika kosong, server membuat kunci acak di data/secret.key pada startup —
# memakai kunci acak berarti semua sesi gugur setiap kali container dibuat ulang.
# Hasilkan dengan:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Kata sandi awal akun 'admin'. Jika kosong, dibuat acak dan dicetak di konsol.
# Jika diisi dari sini, admin TIDAK dipaksa mengganti kata sandi saat login pertama.
ADMIN_PASSWORD=

# Masa berlaku token akses (menit). Default 720 = 12 jam.
SA_TOKEN_TTL_MINUTES=720

# Pembatasan laju percobaan login per alamat IP
SA_LOGIN_RATE_LIMIT=5
SA_LOGIN_RATE_WINDOW_SEC=60

# ----------------------------------------------------------------------
# Perangkat SA124B
# ----------------------------------------------------------------------

# Paksa mode simulator (true) — berguna untuk demo / uji coba tanpa instrumen.
# Jika false, sistem mencoba membuka perangkat fisik dan otomatis jatuh ke
# simulator bila DLL/driver tidak ditemukan.
SA_SIMULATE=false

# Nomor seri perangkat tertentu. Kosongkan untuk memakai perangkat pertama.
# SA_DEVICE_SERIAL=23276018

# Lokasi kustom pustaka driver, jika tidak ada di path pencarian standar.
# Windows: C:\Program Files\Signal Hound\Spike\sa_api.dll
# Linux:   /usr/lib/libsa_api.so
# SA_API_PATH=

# ----------------------------------------------------------------------
# Ambang Batas Okupansi & Perekaman Audio
# ----------------------------------------------------------------------

# Mode ambang batas: adaptive (noise floor + offset) atau fixed
SA_THRESHOLD_MODE=adaptive
SA_ADAPTIVE_OFFSET_DB=10.0
SA_FIXED_THRESHOLD_DBM=-85.0

# Durasi dwell per transmisi terdeteksi (detik)
SA_DWELL_SEC=12.0
# Batas maksimum panjang satu file rekaman (detik)
SA_MAX_RECORDING_SEC=30.0
# Waktu tahan (hang time) setelah sinyal turun di bawah ambang (detik)
SA_HANG_TIME_SEC=2.0

# ----------------------------------------------------------------------
# Path Volume (biasanya dibiarkan default; docker-compose memetakannya)
# ----------------------------------------------------------------------
# SA_DATA_DIR=/app/data
# SA_RECORDINGS_DIR=/app/recordings
# SA_REPORTS_DIR=/app/reports
# SA_LOGS_DIR=/app/logs

# ----------------------------------------------------------------------
# Reverse Proxy (profil `proxy` pada docker-compose)
# ----------------------------------------------------------------------
# Domain publik untuk HTTPS otomatis Let's Encrypt. Gunakan https://<domain>
# Caddy akan menerbitkan sertifikat otomatis saat DOMAIN berupa domain nyata.
DOMAIN=localhost
