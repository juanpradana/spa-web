# Konfigurasi Caddy untuk Handfish Reverse Proxy
# Menangani HTTPS otomatis, kompresi, dan upgrade koneksi WebSocket.

{$DOMAIN:localhost} {
    encode zstd gzip

    # Proxy ke aplikasi FastAPI Handfish
    reverse_proxy handfish:8000 {
        # Header proxy standar
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Timeout WebSocket yang panjang untuk live streaming
        flush_interval -1
    }

    # Header keamanan tambahan pada layer proxy
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output stdout
        format console
    }
}
